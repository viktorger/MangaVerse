<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_chapterdescription_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="@dimen/margin_horizontal_default"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_chapterdescription_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="@dimen/margin_horizontal_default"/>

    <TextView
        android:id="@+id/tv_chapterdescription_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
        app:layout_constrainedWidth="true"

        app:layout_constraintEnd_toEndOf="@id/gl_chapterdescription_2"
        app:layout_constraintStart_toStartOf="@id/gl_chapterdescription_1"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="@string/lorem" />

    <TextView
        android:id="@+id/tv_chapterdescription_genres"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"

        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@id/gl_chapterdescription_2"
        app:layout_constraintStart_toStartOf="@id/gl_chapterdescription_1"
        app:layout_constraintTop_toBottomOf="@id/tv_chapterdescription_description"
        tools:text="Genre 1, genre 2" />

    <TextView
        android:id="@+id/tv_chapterdescription_chapters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/chapters_headline"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/gl_chapterdescription_2"
        app:layout_constraintStart_toStartOf="@id/gl_chapterdescription_1"
        app:layout_constraintTop_toBottomOf="@id/tv_chapterdescription_genres" />

</androidx.constraintlayout.widget.ConstraintLayout>