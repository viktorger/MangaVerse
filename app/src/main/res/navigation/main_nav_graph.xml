<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/homeFragment">
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.viktorger.mangaverse.feature.home.HomeFragment"
        tools:layout="@layout/fragment_home"
        android:label="@string/home_fragment_title" >
        <action
            android:id="@+id/action_homeFragment_to_mangaDescriptionFragment"
            app:destination="@id/mangaDescriptionFragment" />
    </fragment>
    <fragment
        android:id="@+id/libraryFragment"
        android:name="com.viktorger.mangaverse.feature.library.LibraryFragment"
        tools:layout="@layout/fragment_library"
        android:label="@string/library_fragment_title" />
    <fragment
        android:id="@+id/mangaDescriptionFragment"
        android:name="com.viktorger.mangaverse.manga_details.MangaDetailsFragment"
        tools:layout="@layout/fragment_manga_details"
        android:label="MangaDescriptionFragment" >

        <argument
            android:name="mangaUrl"
            app:argType="string" />
        <action
            android:id="@+id/action_mangaDescriptionFragment_to_readFragment"
            app:destination="@id/readFragment" />

    </fragment>
    <fragment
        android:id="@+id/readFragment"
        android:name="com.viktorger.mangaverse.feature.read.ReadFragment"
        tools:layout="@layout/fragment_read"
        android:label="ReadFragment" >
        <argument
            android:name="chapterUrl"
            app:argType="string" />
    </fragment>
</navigation>